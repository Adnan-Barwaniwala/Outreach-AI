    {
      "parameters": {
        "jsCode": "const items = $('Workflow Input').all();\nconst totalLeads = items.length;\nconst emailsSent = items.filter(i => i.json.emailSent === 'Yes').length;\nconst delivered = items.filter(i => i.json.deliveryStatus === 'Delivered').length;\nconst bounced = items.filter(i => i.json.deliveryStatus === 'Bounced').length;\nconst undelivered = items.filter(i => i.json.deliveryStatus === 'Undelivered').length;\nconst unknown = items.filter(i => i.json.deliveryStatus === 'Unknown').length;\n\nconst bounceRate = emailsSent > 0 ? bounced / emailsSent : 0;\nconst deliveryRate = emailsSent > 0 ? delivered / emailsSent : 0;\n\nconst batchId = items[0]?.json.batchId ?? 'unknown';\n\nreturn [{\n  json: {\n    batchId,\n    totalLeads,\n    emailsSent,\n    delivered,\n    bounced,\n    undelivered,\n    unknown,\n    bounceRate,\n    deliveryRate\n  }\n}];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        416,
        0
      ],
      "id": "4cccd77b-f770-482a-9e36-ea3003f2b25e",
      "name": "Compute Bounce Rate"
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 3
          },
          "conditions": [
            {
              "id": "a7566c90-3bfc-4833-8251-3fc5188d0bcc",
              "leftValue": "={{ $json.bounceRate }}",
              "rightValue": 0.05,
              "operator": {
                "type": "number",
                "operation": "gt"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.3,
      "position": [
        624,
        0
      ],
      "id": "e9a42c95-522d-4be0-a9ad-ad8e57c6d1eb",
      "name": "Bounce Rate Check"
    },
    {
      "parameters": {
        "jsCode": "const stats = $input.first().json;                                                                                                                                     \nconst bouncePercent = (stats.bounceRate * 100).toFixed(1);                                                                                                        \nconst deliveryPercent = (stats.deliveryRate * 100).toFixed(1);\n                                                                                                                                                                    \nreturn [{\n  json: {                                                                                                                                                           \n    subject: `ALERT: High Bounce Rate — Batch ${stats.batchId}`,                                                                                                  \n    body: `OltaFlock Campaign Alert\\n\\nBatch ID: ${stats.batchId}\\nStatus: PAUSED — Bounce rate exceeded 5%\\n\\nStats:\\n- Total leads processed: \n${stats.totalLeads}\\n- Emails sent: ${stats.emailsSent}\\n- Delivered: ${stats.delivered} (${deliveryPercent}%)\\n- Bounced: ${stats.bounced} (${bouncePercent}%)\\n-  \nUndelivered: ${stats.undelivered}\\n- Unknown: ${stats.unknown}\\n\\nAction required: Review the Google Sheet log for this batch and investigate bounce sources before \nresuming.`                                                                                                                                                          \n  }                                                                                                                                                                 \n}];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        832,
        -16
      ],
      "id": "81b98d88-d36a-4b4c-b1dd-9ceed3b08b17",
      "name": "Build Bounce Alert"
    },
    {
      "parameters": {
        "jsCode": "const stats = $input.first().json;\nconst bouncePercent = (stats.bounceRate * 100).toFixed(1);\nconst deliveryPercent = (stats.deliveryRate * 100).toFixed(1);                                                                                                      \n                                                              \nreturn [{                                                                                                                                                           \n  json: {                                                                                                                                                         \n    subject: `Campaign Complete — Batch ${stats.batchId}`,\n    body: `OltaFlock Campaign Summary\\n\\nBatch ID: ${stats.batchId}\\nStatus: COMPLETE\\n\\nResults:\\n- Total leads processed: ${stats.totalLeads}\\n- Emails sent:     \n${stats.emailsSent}\\n- Delivered: ${stats.delivered} (${deliveryPercent}%)\\n- Bounced: ${stats.bounced} (${bouncePercent}%)\\n- Undelivered: ${stats.undelivered}\\n- \nUnknown: ${stats.unknown}\\n\\nAll results have been logged to the OltaFlock Google Sheet.`                                                                           \n  }                                                                                                                                                               \n}];   "
      },
